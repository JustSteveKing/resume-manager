# Optional: keys can also be set with `resume config key …` or in Settings (stored in ~/.config, not here).
TABSTACK_API_KEY=
# RESUME_PATH=resume.json
# RESUME_OUT_DIR=dist
# RESUME_VARIANTS_DIR=variants
# RESUME_APPLICATIONS_DIR=applications
ANTHROPIC_API_KEY=
# GITHUB_TOKEN=          # else `gh auth token` is used
# GITLAB_TOKEN=          # else `glab` is used; public projects work without it
# GITLAB_HOST=           # self-hosted GitLab, e.g. https://gitlab.example.com
# RESUME_AI=auto        # auto | claude | tabstack
